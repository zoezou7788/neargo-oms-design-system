  "spacing": {
    "$description": "4px grid — all spacing must be a multiple of 4",
    "1": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "icon gap, micro padding"
    },
    "2": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "badge padding, inline gap"
    },
    "3": {
      "$value": "12px",
      "$type": "dimension"
    },
    "4": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "form field gap, button padding"
    },
    "5": {
      "$value": "24px",
      "$type": "dimension",
      "$description": "★ card padding (default)"
    },
    "6": {
      "$value": "32px",
      "$type": "dimension"
    },
    "7": {
      "$value": "40px",
      "$type": "dimension"
    },
    "8": {
      "$value": "48px",
      "$type": "dimension",
      "$description": "page offset"
    },
    "9": {
      "$value": "64px",
      "$type": "dimension",
      "$description": "section separation"
    }
  },
  "borderRadius": {
    "1": {
      "$value": "3px",
      "$type": "dimension",
      "$description": "checkbox"
    },
    "2": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "badge, tag"
    },
    "3": {
      "$value": "6px",
      "$type": "dimension",
      "$description": "button, input"
    },
    "4": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "★ card (default)"
    },
    "5": {
      "$value": "12px",
      "$type": "dimension",
      "$description": "dialog, dashboard hero card"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension",
      "$description": "pill, avatar"
    }
  },
  "shadow": {
    "1": {
      "$value": "0 1px 2px rgba(0,0,0,.05)",
      "$type": "shadow",
      "$description": "row hover"
    },
    "2": {
      "$value": "0 1px 3px rgba(0,0,0,.08), 0 1px 2px rgba(0,0,0,.04)",
      "$type": "shadow",
      "$description": "★ card default"
    },
    "3": {
      "$value": "0 4px 8px rgba(0,0,0,.06), 0 2px 4px rgba(0,0,0,.04)",
      "$type": "shadow",
      "$description": "right panel"
    },
    "4": {
      "$value": "0 8px 16px rgba(0,0,0,.08), 0 4px 8px rgba(0,0,0,.04)",
      "$type": "shadow",
      "$description": "dropdown, popover"
    },
    "5": {
      "$value": "0 16px 32px rgba(0,0,0,.10)",
      "$type": "shadow",
      "$description": "floating action"
    },
    "6": {
      "$value": "0 24px 48px rgba(0,0,0,.18)",
      "$type": "shadow",
      "$description": "modal dialog"
    }
  },
  "motion": {
    "duration": {
      "instant": {
        "$value": "0ms",
        "$type": "duration"
      },
      "fast": {
        "$value": "100ms",
        "$type": "duration",
        "$description": "hover, focus ring"
      },
      "normal": {
        "$value": "150ms",
        "$type": "duration",
        "$description": "★ DEFAULT"
      },
      "moderate": {
        "$value": "200ms",
        "$type": "duration",
        "$description": "dropdown open, tab switch"
      },
      "slow": {
        "$value": "250ms",
        "$type": "duration",
        "$description": "accordion, card expand"
      },
      "enter": {
        "$value": "200ms",
        "$type": "duration"
      },
      "exit": {
        "$value": "150ms",
        "$type": "duration",
        "$description": "always < enter"
      },
      "page": {
        "$value": "300ms",
        "$type": "duration"
      }
    },
    "easing": {
      "out": {
        "$value": "cubic-bezier(0.0,0.0,0.2,1.0)",
        "$type": "cubicBezier",
        "$description": "enter viewport"
      },
      "in": {
        "$value": "cubic-bezier(0.4,0.0,1.0,1.0)",
        "$type": "cubicBezier",
        "$description": "leave viewport"
      },
      "inout": {
        "$value": "cubic-bezier(0.4,0.0,0.2,1.0)",
        "$type": "cubicBezier",
        "$description": "continuous move"
      },
      "spring": {
        "$value": "cubic-bezier(0.34,1.56,0.64,1.0)",
        "$type": "cubicBezier",
        "$description": "switch, badge pop"
      },
      "bounce": {
        "$value": "cubic-bezier(0.36,0.07,0.19,0.97)",
        "$type": "cubicBezier",
        "$description": "toast enter"
      },
      "gentle": {
        "$value": "cubic-bezier(0.25,0.46,0.45,0.94)",
        "$type": "cubicBezier",
        "$description": "dialog open"
      }
    }
  },
